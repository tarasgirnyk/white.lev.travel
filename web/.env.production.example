# Приклад .env для сервера (docker-compose, нативний Postgres на хості).
# Скопіюй у web/.env і заповни.
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=https://white.lev.travel
SITE_ADDRESS=white.lev.travel

# Підключення до вже наявного на сервері Postgres (не в докері).
# Заздалегідь створи базу й юзера в цьому Postgres (див. README, розділ "Деплой").
# host.docker.internal — це сама серверна машина, видима з контейнера
# (extra_hosts у docker-compose.yml вже налаштований).
DATABASE_URI=postgres://wlt:CHANGE_ME@host.docker.internal:5432/whitelevtravel

SEED_ON_INIT=true
ADMIN_EMAIL=gor@miotex.com
ADMIN_PASSWORD=
